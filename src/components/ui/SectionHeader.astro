---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description?: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<header class="section-header">
  <p class="section-eyebrow">{eyebrow}</p>

  <h2 id={id}>{title}</h2>

  {description && <p class="section-description">{description}</p>}
</header>

<style>
  .section-header {
    max-width: 960px;
  }

  .section-eyebrow {
    margin: 0;
    color: var(--accent);
    font-family: monospace;
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .section-header h2 {
    max-width: 20ch;
    margin: 18px 0 0;
    font-size: clamp(2.15rem, 3.4vw, 3.65rem);
    line-height: 1.03;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .section-description {
    max-width: 760px;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    line-height: 1.7;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .section-header h2 {
      max-width: 20ch;
      font-size: clamp(2rem, 5.2vw, 3.3rem);
    }
  }

  @media (max-width: 600px) {
    .section-header h2 {
      max-width: none;
      margin-top: 15px;
      font-size: clamp(1.8rem, 7.8vw, 2.6rem);
      line-height: 1.06;
      letter-spacing: -0.038em;
    }

    .section-eyebrow {
      font-size: 0.64rem;
      letter-spacing: 0.14em;
    }

    .section-description {
      margin-top: 16px;
      font-size: 0.94rem;
      line-height: 1.65;
    }
  }
</style>
